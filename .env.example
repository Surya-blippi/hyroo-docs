# Dodo Payments — leave unset to run Hyroo in demo checkout mode.
# 1. Put your API key here and choose the mode.
DODO_PAYMENTS_API_KEY=
DODO_MODE=test                 # test | live

# 2. Create the one-time ₹499 product, then paste its id here:
#      npm run dodo:setup
DODO_PRODUCT_ID=

# 3. Set to 1 to enable real checkout in the UI (otherwise demo mode).
NEXT_PUBLIC_DODO_ENABLED=

# Resend: emails the kit to the buyer after payment (optional; skipped if unset).
# Verify your domain in Resend to send to customers, then set RESEND_FROM
# to an address on that domain, e.g. "Hyroo <kit@hyroo.in>".
RESEND_API_KEY=
RESEND_FROM=
